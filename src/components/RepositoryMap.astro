---
import type { Project } from "../data/projects";
import { workMessages } from "../i18n/work";
import type { Locale } from "../i18n";

interface Props { project: Project; locale: Locale; decorative?: boolean }
const { project, locale, decorative = false } = Astro.props;
const labels = workMessages[locale].roles;
const { repositories, edges = [] } = project;
const count = repositories.length;
// Diagrams share a frame. Coordinates belong to four topologies, not to individual repos.
const positions = count === 1 ? [[40, 24]]
  : count === 2 ? (repositories[0].surface === "api" ? [[58, 24], [22, 24]] : [[22, 24], [58, 24]])
  : count === 4 ? [[16, 12], [16, 36], [52, 24], [70, 24]]
  : [[14, 24], [60, 6], [60, 18], [60, 30], [60, 42]];
const nodes = repositories.map((repo, i) => ({
  ...repo,
  x: positions[i]?.[0] ?? 40,
  y: positions[i]?.[1] ?? 24,
  tone: project.slug === "saber-inverso" ? "data" : repo.surface === "cli" ? "mcp" : repo.surface,
}));
const links = edges.flatMap(([from, to]) => {
  const a = nodes[from], b = nodes[to];
  return a && b ? [`M${a.x} ${a.y} Q${(a.x + b.x) / 2} ${a.y} ${b.x} ${b.y}`] : [];
});
const description = repositories.map(({ role, name }) => `${labels[role]}: ${name}`).join("; ");
---

<svg class="repo-map" viewBox="0 0 80 48" width="80" height="48" role={decorative ? undefined : "img"} aria-hidden={decorative ? "true" : undefined} aria-label={decorative ? undefined : description}>
  {links.map((d) => <path {d} />)}
  {nodes.map(({ x, y, tone }) => <circle cx={x} cy={y} r="4" class={`node-${tone}`} />)}
</svg>

<style>
  .repo-map { display: block; width: 100%; height: auto; color: var(--subtle); }
  path { fill: none; stroke: currentColor; stroke-dasharray: 2 2; }
  .node-web { fill: var(--cat-web); }
  .node-api { fill: var(--cat-api); }
  .node-infra { fill: var(--cat-infra); }
  .node-mcp { fill: var(--cat-mcp); }
  .node-data { fill: var(--cat-data); }
  @media (forced-colors: active) { circle { fill: CanvasText; } }
</style>
