---
import { languages, localePath, otherLocale, pagePath, sections, siteHandle, t, type Locale, type Page } from "../i18n";
import { workMessages } from "../i18n/work";

interface Props {
  locale: Locale;
  page?: Page;
}

const { locale, page = "home" } = Astro.props;
const alternate = otherLocale(locale);
const alternatePath = pagePath(alternate, page);
const language = languages[alternate];
const dark = t(locale, "dark");
const light = t(locale, "light");
---

<header class="site-nav" data-site-nav data-work-nav={page === "work" ? "" : undefined}>
  <div class="wrap nav-inner">
    <a class="brand font-mono" href={localePath(locale)}>{siteHandle}</a>
    <nav id="primary-nav" class="nav-links" aria-label={t(locale, "primary")}>
      <ul>
        {page === "work" ? (
          <>
            <li><a href={localePath(locale)}><span aria-hidden="true">←</span> {workMessages[locale].home}</a></li>
            <li class="current-page"><span aria-current="page">{t(locale, "work")}</span></li>
          </>
        ) : sections.map((section) => (
          <li><a href={`#${section}`} data-section-link><span>{t(locale, section)}</span></a></li>
        ))}
        <li class="mobile-language">
          <a href={alternatePath} hreflang={alternate} lang={alternate}>{language.label}</a>
        </li>
      </ul>
      {page === "home" && <span class="nav-indicator bg-gold" data-nav-indicator aria-hidden="true"></span>}
    </nav>
    <div class="nav-tools">
      <button
        class="nav-control"
        type="button"
        data-search-trigger
        aria-haspopup="dialog"
        aria-controls="command-menu"
        aria-keyshortcuts="Control+K Meta+K"
        hidden
      >
        <span class="search-label">{t(locale, "search")}</span>
        <kbd>Ctrl K</kbd>
      </button>
      <a
        class="nav-control desktop-language"
        href={alternatePath}
        hreflang={alternate}
        lang={alternate}
        aria-label={language.label}
      >{language.short}</a>
      <button
        class="nav-control theme-toggle"
        type="button"
        data-theme-toggle
        aria-label={`${dark} / ${light}: ${t(locale, "themeLabel")}`}
        aria-pressed="false"
        hidden
      >
        <span class="theme-dark">{dark}</span>
        <span class="theme-light">{light}</span>
      </button>
      <button
        class="nav-control menu-toggle"
        type="button"
        data-menu-toggle
        aria-controls="primary-nav"
        aria-expanded="false"
      >{t(locale, "menu")}</button>
    </div>
  </div>
</header>

<script>
  import "../scripts/nav";
</script>

<style>
  .site-nav {
    position: sticky;
    z-index: 20;
    inset-block-start: 0;
    border-block-end: 1px solid var(--hair);
    background: var(--surface);
  }

  @supports ((backdrop-filter: blur(20px)) or (-webkit-backdrop-filter: blur(20px))) and
    (background: color-mix(in srgb, red 82%, transparent)) {
    .site-nav {
      background: color-mix(in srgb, var(--surface) 82%, transparent);
      -webkit-backdrop-filter: blur(20px);
      backdrop-filter: blur(20px);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-nav {
      background: var(--surface);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: calc(var(--unit) * 2.5);
    min-height: calc(var(--unit) * 7.5);
  }

  .brand {
    margin-inline-end: auto;
    font-size: 15px;
    font-weight: 600;
  }

  .nav-links {
    position: relative;
  }

  [data-work-nav] .brand { margin-inline-end: 0; }
  [data-work-nav] .nav-links { margin-inline-end: auto; }
  .current-page { padding: var(--unit) calc(var(--unit) * 1.5); font-size: 14px; font-weight: 600; }
  .current-page::before { content: "/" / ""; margin-inline-end: var(--unit); color: var(--muted); }

  ul,
  .nav-tools {
    display: flex;
    align-items: center;
    gap: calc(var(--unit) / 2);
  }

  .nav-links a {
    display: block;
    padding: var(--unit) calc(var(--unit) * 1.5);
    color: var(--subtle);
    font-size: 14px;
  }

  .nav-links a:is(:hover, :focus-visible, [aria-current="location"]),
  .nav-control:not(:disabled):hover {
    color: var(--text);
  }

  .nav-indicator {
    position: absolute;
    inset: auto auto 0 0;
    width: 0;
    height: 2px;
    pointer-events: none;
    opacity: 0;
    transition: transform 320ms var(--ease-out), width 320ms var(--ease-out), opacity 150ms ease;
  }

  .nav-indicator:not([data-visible]) {
    transition: opacity 150ms ease;
  }

  .nav-indicator[data-visible] {
    opacity: 1;
  }

  .nav-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--unit) * 0.75);
    min-height: calc(var(--unit) * 5);
    min-width: calc(var(--unit) * 5);
    padding-inline: var(--unit);
    border: 1px solid var(--control);
    border-radius: var(--r-sm);
    color: var(--subtle);
    font: 500 13px var(--sans);
    white-space: nowrap;
  }

  .nav-control:not(:disabled) {
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }

  .nav-control:not(:disabled):active {
    transform: scale(0.97);
  }

  kbd {
    padding: 1px 5px;
    border: 1px solid var(--hair);
    border-radius: var(--r-sm);
    color: var(--muted);
    font: 500 11px var(--mono);
  }

  .theme-toggle {
    min-width: 5.4em;
  }

  /* With JS the search and theme controls are reserved from first paint; their scripts
     remove `hidden` moments later, so the toolbar does not shift sideways. */
  :global(:root[data-js]) .nav-control[hidden] {
    display: inline-flex;
    visibility: hidden;
  }

  .theme-light,
  :global([data-theme="light"]) .theme-dark,
  .menu-toggle,
  .mobile-language {
    display: none;
  }

  :global([data-theme="light"]) .theme-light {
    display: inline;
  }

  @media (max-width: 860px) {
    .nav-inner {
      gap: var(--unit);
      flex-wrap: wrap;
    }

    [data-work-nav] .brand { margin-inline-end: auto; }
    .current-page::before { display: none; }

    .search-label,
    .desktop-language,
    .nav-indicator {
      display: none;
    }

    .mobile-language {
      display: block;
    }

    .nav-links {
      order: 1;
      width: 100%;
    }

    .nav-links ul {
      flex-wrap: wrap;
    }

    /* Collapsed-menu layout keys on :root[data-js], set by an inline head script before
       first paint, so the header never renders tall and then shrinks when nav.ts runs (CLS). */
    :global(:root[data-js]) .menu-toggle {
      display: inline-flex;
    }

    :global(:root[data-js]) .nav-links {
      position: absolute;
      inset: 100% 0 auto;
      border-block-end: 1px solid var(--hair);
      background: var(--surface);
    }

    :global(:root[data-js]) .site-nav:not([data-menu-open]) .nav-links {
      display: none;
    }

    :global(:root[data-js]) .nav-links ul {
      flex-direction: column;
      align-items: stretch;
      max-width: var(--container);
      padding: var(--unit) calc(var(--unit) * 2.5) calc(var(--unit) * 2);
    }

    :global(:root[data-js]) .nav-links a {
      padding-block: calc(var(--unit) * 1.5);
      font-size: 16px;
    }

    .nav-links a[aria-current="location"] { font-weight: 600; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-indicator,
    .nav-indicator:not([data-visible]),
    .nav-control:not(:disabled) {
      transition: none;
    }

    .nav-control:not(:disabled):active {
      transform: none;
    }
  }
</style>
