---
import { existsSync } from "node:fs";
import { join } from "node:path";

interface Props {
  asset: "hero-poster" | "horizon" | "portrait";
  annotation: string;
}

const { asset, annotation } = Astro.props;
const themes = ["dark", "light"] as const;
interface AssetDimensions { file: string; width: number; height: number }
const [manifest = []] = Object.values(import.meta.glob<readonly AssetDimensions[]>("../data/dither-manifest.json", { eager: true, import: "default" }));
const dimensions = (src: string) => {
  const entry = manifest.find((record) => record.file === src);
  return entry ? { width: entry.width, height: entry.height } : {};
};
const hasAsset = (name: string) => existsSync(join(process.cwd(), "public", "dither", name));
const frames = asset === "portrait" ? Object.fromEntries(themes.map((theme) => [theme, Array.from({ length: 6 }, (_, i) => {
  const file = `portrait-${theme}-${i}.png`;
  return hasAsset(file) ? `/dither/${file}` : null;
})])) : undefined;
const poster = (theme: (typeof themes)[number]) => {
  const file = `${asset}-${theme}.png`;
  return hasAsset(file) ? `/dither/${file}` : undefined;
};
---

<figure class:list={['dither-poster', asset]} data-portrait={asset === 'portrait' ? JSON.stringify(frames) : undefined} aria-hidden="true">
  {themes.map((theme) => {
    if (asset !== 'portrait') {
      const src = poster(theme);
      return src && <img class={theme} {src} {...dimensions(src)} alt="" decoding="async" loading={asset === 'horizon' ? 'lazy' : 'eager'} />;
    }
    const src = frames?.[theme]?.[0];
    return src && <img class={theme} {src} alt="" width="44" height="44" decoding="async" loading="lazy" />;
  })}
</figure>

<style>
  .dither-poster { position: relative; height: 100%; background: var(--surface); overflow: hidden; }
  .dither-poster img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; }
  .hero-poster img { object-fit: contain; }
  .light, :global([data-theme="light"]) .dark { visibility: hidden; }
  :global([data-theme="light"]) .light { visibility: visible; }
  .portrait { width: 88px; height: 88px; margin-block-start: 16px; border: 1px solid var(--hair); border-radius: var(--r); cursor: crosshair; }
  .portrait:not(:has(img)), .dither-poster:not(:has(img)) figcaption { display: none; }
  .portrait figcaption { inset-inline-end: 4px; }
  .horizon { height: 220px; margin-block-start: 40px; }
  @media (max-width: 640px) { .horizon { height: 140px; } }
  @media (forced-colors: active), print { .portrait, .horizon { display: none; } }
</style>
