---
import DitherPoster from "./DitherPoster.astro";
import { contact } from "../data/home";
import { languages, localePath, otherLocale, sections, siteName, t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const alternate = otherLocale(locale);
const year = new Date().getUTCFullYear();
const elsewhere = [
  ["github", contact.github],
  ["linkedin", contact.linkedin],
  ["email", "#contact"],
  ["cvPdf", contact.cvPdf[locale]],
] as const;
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="identity">
      <p class="name">{siteName}</p>
      <p>{t(locale, "footerRole")}</p>
      <DitherPoster asset="portrait" annotation={t(locale, 'portraitEffect')} />
    </div>
    <nav aria-labelledby="footer-site">
      <h2 id="footer-site">{t(locale, "site")}</h2>
      <ul>
        {sections.map((section) => (
          <li><a href={`#${section}`}>{t(locale, section === "about" ? "experience" : section)}</a></li>
        ))}
      </ul>
    </nav>
    <div>
      <h2>{t(locale, "elsewhere")}</h2>
      <ul>
        {elsewhere.map(([key, href]) => <li><a {href}>{t(locale, key)}</a></li>)}
      </ul>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} {siteName}</span>
      <a href={localePath(alternate)} hreflang={alternate} lang={alternate}>
        {languages[alternate].label}
      </a>
    </div>
  </div>
  <DitherPoster asset="horizon" annotation={t(locale, 'horizonEffect')} />
</footer>

<script>
  import "../scripts/portrait";
</script>

<style>
  .site-footer {
    margin-block-start: calc(var(--unit) * 10);
    padding-block-start: calc(var(--unit) * 4);
    border-block-start: 1px solid var(--hair);
    color: var(--muted);
    font-size: 14px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: calc(var(--unit) * 4);
  }

  h2 {
    margin-block-end: calc(var(--unit) * 1.5);
    font: 500 12px/1.3 var(--mono);
  }

  .name {
    color: var(--text);
    font-weight: 600;
  }

  .identity,
  a {
    color: var(--subtle);
  }

  ul a {
    display: inline-block;
    padding-block: calc(var(--unit) * 0.75);
  }

  a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--unit) calc(var(--unit) * 2);
    grid-column: 1 / -1;
    padding-block-start: calc(var(--unit) * 2.5);
    border-block-start: 1px solid var(--hair);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .identity {
      grid-column: 1 / -1;
    }
  }
</style>
