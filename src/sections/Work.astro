---
import { projects } from "../data/home";
import { atlasProjects } from "../data/projects";
import { t, workPath, type Locale } from "../i18n";

const { locale } = Astro.props as { locale: Locale };
---

<section class="wrap" id="work" aria-labelledby="work-heading">
  <header class="section-head work-head" data-reveal>
    <h2 id="work-heading">{t(locale, 'selectedWork')}</h2>
    <a href={workPath(locale)}>{t(locale, 'allProjects').replace('{count}', String(atlasProjects.length))} <span class="go" aria-hidden="true">→</span></a>
  </header>
  <ul class="bento">
    {projects.map((project) => (
      <li class="card" id={project.id} data-reveal tabindex="-1">
        <a href={project.href} aria-labelledby={`${project.id}-title`}>
          {'terminal' in project ? (
            <div class="cover terminal">
              <pre class="sr-only">$ node verify.mjs draft.md{'\n'}93 {t(locale, 'terminalRules')}{'\n'}16 {t(locale, 'terminalSkills')}{'\n'}0 {t(locale, 'terminalDependencies')}</pre>
              <pre data-terminal aria-hidden="true"><span data-line>$ node verify.mjs draft.md</span>{'\n'}<span data-line><b>93</b> {t(locale, 'terminalRules')}</span>{'\n'}<span data-line><b>16</b> {t(locale, 'terminalSkills')}</span>{'\n'}<span data-line>0 {t(locale, 'terminalDependencies')}</span><span class="caret" aria-hidden="true"></span></pre>
            </div>
          ) : (
            <div class="cover field" data-bayer={project.shape} data-seed={project.seed} aria-hidden="true">
            </div>
          )}
          <h3 id={`${project.id}-title`}>{project.name} {'live' in project && <span class="status">{t(locale, 'live')}</span>}<span class="go" aria-hidden="true">→</span></h3>
          <p class="description">{t(locale, project.description)}</p>
          <ul class="categories">
            {project.categories.map((category) => <li><i aria-hidden="true"></i>{category}</li>)}
          </ul>
          <p class="card-foot"><span>{t(locale, project.kind)}</span><span class="font-mono">{'stackLabel' in project ? t(locale, project.stackLabel) : project.stack}</span></p>
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  import "../scripts/terminal";
</script>

<style>
  .work-head { grid-template-columns:1fr auto; align-items:end; }
  .work-head a { color:var(--ink); font-size:14px; font-weight:600; }
  .bento { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }
  .card:first-child { grid-column:span 2; grid-row:span 2; }
  .card:first-child .cover { height:auto; min-height:320px; flex:1; }
  .card:first-child h3 { font-size:26px; }
  .card a { display:flex; flex-direction:column; height:100%; overflow:hidden; border:1px solid var(--hair); border-radius:var(--r); background:var(--raised); color:inherit; transition:border-color 180ms ease, transform 220ms var(--ease-out); }
  .card a:is(:hover,:focus-visible) { border-color:var(--gold); }
  .card a:hover { transform:translateY(-3px); }
  .card a:active { transform:scale(.99); }
  .cover { position:relative; height:168px; flex:none; overflow:hidden; border-block-end:1px solid var(--hair); background:var(--surface); }
  .terminal { padding:16px; transition:background-color 180ms ease; }
  .terminal pre { color:var(--subtle); font:13px/1.7 var(--mono); white-space:pre-wrap; }
  .terminal [data-line]:first-child { color:var(--text); }
  .terminal b { color:var(--ink); font-weight:600; }
  .terminal [data-terminal]:not([data-ready]) .caret { display:none; }
  .caret { display:inline-block; width:.6em; height:1.1em; margin-inline-start:2px; vertical-align:-.15em; background:var(--gold); }
  @media (prefers-reduced-motion:no-preference) {
    .card a:is(:hover,:focus-visible) [data-terminal]:not([data-typing]) .caret { animation:blink 1s steps(1) 4; }
  }
  @keyframes blink { 50% { opacity:0; } }
  .card a:is(:hover,:focus-visible) .terminal { background:color-mix(in srgb,var(--surface) 70%,var(--raised)); }
  h3 { display:flex; align-items:center; gap:8px; margin:16px 18px 6px; font-size:19px; font-weight:600; overflow-wrap:anywhere; }
  h3 .go { margin-inline-start:auto; opacity:0; transform:translateX(-4px); transition:opacity 180ms ease, transform 180ms var(--ease-out); }
  .card a:is(:hover,:focus-visible) .go { opacity:1; transform:none; }
  .description { margin:0 18px 12px; color:var(--subtle); font-size:15px; }
  .categories { display:flex; flex-wrap:wrap; gap:6px 12px; margin:0 18px 12px; color:var(--subtle); font:500 12px var(--mono); }
  .categories li { display:flex; align-items:center; gap:6px; }
  .categories i { width:8px; height:8px; background:var(--ink); }
  .status { border:1px solid var(--ink); border-radius:var(--r-sm); padding:2px 6px; font:500 12px var(--mono); white-space:nowrap; }
  .card-foot { display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:8px; margin-block-start:auto; padding:12px 18px; border-block-start:1px solid var(--hair); color:var(--muted); font-size:13px; }
  @media (max-width:900px) {
    .work-head, .bento { grid-template-columns:minmax(0,1fr); }
    .card:first-child { grid-column:auto; grid-row:auto; }
    .card:first-child .cover { min-height:200px; }
  }
</style>
