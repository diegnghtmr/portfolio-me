---
import { principles } from "../data/home";
import { t, type Locale } from "../i18n";

const { locale } = Astro.props as { locale: Locale };
---

<section class="wrap" aria-labelledby="principles-heading">
  <header class="section-head" data-reveal>
    <h2 id="principles-heading">{t(locale, 'how')}</h2>
    <p>{t(locale, 'howIntro')}</p>
  </header>
  <ol>
    {principles.map(({ title, text, project }, i) => (
      <li data-reveal>
        <span class="row-number" aria-hidden="true">0{i + 1}</span>
        <div><h3>{t(locale, title)}</h3><p>{t(locale, text)}</p></div>
        <a href={`#${project.id}`}><span><small>{t(locale, 'evidence')}</small>{project.name}</span><span class="go" aria-hidden="true">→</span></a>
      </li>
    ))}
  </ol>
</section>

<style>
  ol { border-block-start:1px solid var(--hair); }
  li { display:grid; grid-template-columns:64px minmax(0,1fr) 220px; align-items:center; gap:24px; padding:24px 16px; border-block-end:1px solid var(--hair); }
  .row-number { color:var(--muted); font:500 14px var(--mono); }
  h3 { margin-block-end:4px; font-size:20px; font-weight:600; }
  p { max-width:58ch; color:var(--subtle); }
  a { display:flex; justify-content:space-between; align-items:center; gap:6px; min-height:48px; padding-inline:16px; border:1px solid var(--control); border-radius:var(--r); color:var(--text); font-size:14px; transition:border-color 150ms ease; }
  a:hover { border-color:var(--ink); color:var(--text); }
  a span:first-child { display:grid; line-height:1.25; }
  small { color:var(--muted); font:500 11px var(--mono); }
  @media (max-width:900px) {
    li { grid-template-columns:40px minmax(0,1fr); gap:12px 16px; padding:20px 0; }
    a { grid-column:2; max-width:260px; }
  }
</style>
