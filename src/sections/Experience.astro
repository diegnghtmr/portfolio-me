---
import { contact, experience } from "../data/home";
import { t, type Locale } from "../i18n";

const { locale } = Astro.props as { locale: Locale };
---

<section class="wrap experience" id="about" aria-labelledby="experience-heading">
  <div class="side" data-experience-side data-reveal>
    <h2 id="experience-heading">{t(locale, 'experience')}</h2>
    <p>{t(locale, 'experienceIntro')}</p>
    <a href={contact.cvPdf[locale]} class="home-button">{t(locale, 'downloadCv')}</a>
  </div>
  <ol class="timeline" data-reveal-line>
    {experience.map(({ dates, current, title, organization, text }) => (
      <li class:list={[{ current }]} data-reveal>
        <div class="dates">{t(locale, dates)} {current && <span>{t(locale, 'current')}</span>}</div>
        <h3>{t(locale, title)}</h3>
        <p class="org">{t(locale, organization)}</p>
        <p>{t(locale, text)}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .experience { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.6fr); gap:64px; margin-block-start:96px; }
  .side { position:sticky; align-self:start; inset-block-start:var(--side-top,96px); }
  h2 { margin-block-end:12px; font-size:28px; font-weight:600; line-height:1.2; }
  .side p { max-width:36ch; margin-block-end:24px; color:var(--subtle); }
  .timeline { position:relative; }
  .timeline::before { content:""; position:absolute; inset:10px auto 16px 5px; width:1px; background:var(--control); transform-origin:top; }
  @media (prefers-reduced-motion:no-preference) {
    .timeline[data-reveal-pending]::before { transform:scaleY(0); }
    .timeline:not([data-reveal-pending])::before { transition:transform 1100ms var(--ease-out); }
  }
  li { position:relative; padding:0 0 36px 36px; }
  li::before { content:""; position:absolute; inset:6px auto auto 0; width:11px; height:11px; border:1px solid var(--control); border-radius:50%; background:var(--surface); }
  .current::before { border-color:var(--gold); background:var(--gold); }
  .dates { display:flex; gap:10px; align-items:center; color:var(--muted); font:500 13px var(--mono); }
  .dates span { color:var(--gold-text); }
  h3 { margin-block:6px 2px; font-size:19px; font-weight:600; }
  .org { margin-block-end:8px; color:var(--ink); font-size:14px; }
  li p:last-child { max-width:56ch; color:var(--subtle); }
  @media (max-width:900px) {
    .experience { grid-template-columns:minmax(0,1fr); gap:28px; margin-block-start:72px; }
    .side { position:static; }
  }
</style>
