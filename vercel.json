{
  "cleanUrls": false,
  "functions": {
    "api/mcp.mjs": { "includeFiles": "api/_generated/portfolio.json" }
  },
  "headers": [
    {
      "source": "/(dither/[^/]+\\.png|favicon\\.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(en|es|en/work|es/trabajo)/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/(en/work|es/trabajo)/([a-z0-9-]+)/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/llms(.*)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/es/llms(.*)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "[eE][sS](.*)"
        }
      ],
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/:path((?!(?:api/)?mcp/?$|\\.well-known(?:/|$))(?:[^/]+/)*[^/.]+)",
      "destination": "/:path/",
      "permanent": true
    },
    {
      "source": "/:path((?!\\.well-known(?:/|$))(?:[^/]+/)*[^/]+\\.\\w+)/",
      "destination": "/:path",
      "permanent": true
    }
  ]
}
